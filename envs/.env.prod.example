# Production settings: the API's App Service "Environment variables" (app settings), not a file the
# app reads. See docs/deploy-azure.md for where each value comes from. IMAGE_TAG is set by the deploy
# workflow; don't set it by hand.
ENVIRONMENT=production
LOG_LEVEL=info
# The interactive API docs (/docs, /redoc): off in production unless this is true
API_DOCS=false

# App Service: the API listens on 8000
WEBSITES_PORT=8000

# Azure Database for PostgreSQL flexible server. Connections are encrypted (sslmode=require is the
# production default).
POSTGRES_HOST=<server-name>.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_USER=openread
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=openread

# Signs login tokens. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-run-openssl-rand-hex-32

# The FE's public address: links in emails point here, and it's the one site allowed to call
# the API (CORS). The API runs on a subdomain of the same domain, e.g. api.openread.example.com.
FE_URL=https://openread.example.com

# Azure Communication Services Email: the resource's connection string (Settings → Keys), and the
# MailFrom address of its connected, verified domain.
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
EMAIL_FROM=DoNotReply@<your-domain>

# Azure Blob Storage: the storage account's connection string (Security + networking → Access keys),
# and its container with anonymous read access for blobs.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_MEDIA=media
