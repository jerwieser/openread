ENVIRONMENT=local
LOG_LEVEL=debug

POSTGRES_USER=openread
POSTGRES_PASSWORD=openread
POSTGRES_DB=openread
# "localhost" when running the app on your machine (uv run ...);
# compose overrides host and port inside containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Signs login tokens. Any value works locally.
SECRET_KEY=local-dev-secret-not-for-production-use

# Links in emails point here. Locally emails are printed in the API logs, not sent.
FE_URL=http://localhost:5173
